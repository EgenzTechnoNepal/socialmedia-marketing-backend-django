# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.trycloudflare.com

# Must match Go config.toml [jwt] secret so cookie tokens work on both backends
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY_MINS=15
JWT_REFRESH_EXPIRY_DAYS=1
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS (Vue Vite default)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL. DATABASE_URL wins over POSTGRES_* (Neon, RDS, or future self-hosted).
# Do not commit real passwords. Neon pooler URLs are OK — Django uses the direct host for DDL.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=whatomate
POSTGRES_PASSWORD=whatomate
POSTGRES_DB=whatomate

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Must match Go [app] encryption_key (empty = store tokens in plaintext, like Go dev)
ENCRYPTION_KEY=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=random-string-change-this
WHATSAPP_API_VERSION=v24.0
# Fallback Meta app credentials for embedded signup (org settings override these)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
STORAGE_LOCAL_PATH=./media
# Must match Go [calling] audio_dir (repo-root ./audio by default)
CALLING_AUDIO_DIR=./audio

# Public frontend URL used as Dodo checkout return
PUBLIC_APP_URL=http://localhost:3000
PUBLIC_API_URL=https://peers-maintained-pig-bridge.trycloudflare.com

# Dodo Payments (test mode)
DODO_PAYMENTS_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
DODO_RETURN_URL=http://localhost:3000/settings/billing
DODO_PRODUCT_PRO=
DODO_PRODUCT_BUSINESS=
DODO_ADDON_SEAT=
DODO_METER_MESSAGE_SENT=message.sent
DODO_METER_AI_COMPLETION=ai.completion
DODO_METER_CAMPAIGN_RECIPIENT=campaign.recipient
